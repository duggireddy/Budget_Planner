# sqlite = default, works without Docker (data in data/budget.db)
# mysql = requires docker compose up -d
DB_BACKEND=sqlite

# Login (only applied when data/auth.json is created on FIRST run)
# BUDGET_AUTH_USER=your_username
# BUDGET_AUTH_PASSWORD=your_password
# BUDGET_RESET_CODE=12345

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=budget
MYSQL_PASSWORD=budget
MYSQL_DATABASE=budget_app
